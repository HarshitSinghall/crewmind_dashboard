# Copy to .env.local. Never commit .env.local.
#
# The publishable key is safe in the browser: it carries no privileges of its
# own and every request is still subject to RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Where magic-link emails send the user back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LOCAL ONLY. Shows a password form on the login page so you can open the demo
# tenants, whose email domains are fabricated and can never receive a magic
# link. Delete this line before deploying - production is magic link only.
NEXT_PUBLIC_ALLOW_PASSWORD_LOGIN=true

# Optional staging-test configuration. Tests refuse to run without this exact
# sentinel, the expected project ref, fixture-prefixed tenant slugs, and real
# disposable fixture UUIDs. Never point these values at customer or shared demo rows.
TEST_FIXTURE_CONFIRM=CREWMIND_DISPOSABLE_FIXTURES_V1
TEST_ENVIRONMENT=staging
TEST_EXPECTED_SUPABASE_PROJECT_REF=your-staging-project
TEST_PASSWORD=fixture-account-password
TEST_FIXTURE_OWNER_A_EMAIL=owner-a@fixture.invalid
TEST_FIXTURE_AGENT_A_EMAIL=agent-a@fixture.invalid
TEST_FIXTURE_OWNER_B_EMAIL=owner-b@fixture.invalid
TEST_FIXTURE_ORG_A_ID=replace-with-authorized-fixture-uuid
TEST_FIXTURE_ORG_A_SLUG=fixture-tenant-a
TEST_FIXTURE_ORG_A_NAME=Fixture Tenant A
TEST_FIXTURE_ORG_B_ID=replace-with-authorized-fixture-uuid
TEST_FIXTURE_ORG_B_SLUG=fixture-tenant-b
TEST_FIXTURE_LEAD_A_ID=replace-with-authorized-fixture-uuid
TEST_FIXTURE_DELETE_LEAD_A_ID=replace-with-authorized-fixture-uuid
TEST_FIXTURE_LEAD_B_ID=replace-with-authorized-fixture-uuid
TEST_FIXTURE_DELETE_LEAD_B_ID=replace-with-authorized-fixture-uuid
TEST_FIXTURE_CALL_B_ID=replace-with-authorized-fixture-uuid
TEST_FIXTURE_COST_B_ID=replace-with-authorized-fixture-uuid
TEST_APP_URL=http://localhost:3000

# NOTE: there is deliberately no SUPABASE_SERVICE_ROLE_KEY here.
# The dashboard never uses the service role. If you ever find yourself adding
# it, stop - it bypasses every RLS policy in SECURITY.md.
